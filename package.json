{
  "name": "@einaraglen/quorum",
  "version": "1.0.0",
  "description": "Distributed pod coordination: Bully leader election and work sharding",
  "keywords": [
    "leader-election",
    "sharding",
    "distributed-systems"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einaraglen/quorum.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test --test-reporter=spec --test-reporter-destination=stdout src/**/*.test.ts",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.2",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
