{
  "name": "@einaraglen/quorum",
  "version": "1.0.0",
  "description": "Distributed pod coordination: Bully leader election and work sharding",
  "keywords": [
    "leader-election",
    "sharding",
    "distributed-systems"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einaraglen/quorum.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test --test-reporter=spec --test-reporter-destination=stdout src/**/*.test.ts",
    "test:ci": "tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml src/**/*.test.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
